  "emitted_by_model": "all codes above except PROVIDER_FRAUD_VERDICT (injected by the liveness/anti-fraud provider at consolidation)",
  "confidence_routing": { "low": "REVIEW (desk) even with no findings" },
  "attempt_mapping_proposal": {
    "APPROVE": { "status": "COMPLETED", "result": "APPROVED" },
    "REJECT": { "status": "COMPLETED", "result": "REJECTED", "rejectionLabels": "REJECT codes of the findings", "resultMessage": "detail of the first REJECT finding", "retryable": "true (to confirm exceptions: PROVIDER_FRAUD_VERDICT, PERSON_MISMATCH)" },
    "REVIEW": { "status": "PROCESSING or UNDER_REVIEW", "desk_queue": true, "note": "never auto-reject, never auto-RFI" }
  }
